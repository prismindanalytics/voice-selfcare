# ─────────────────────────────────────────────────────────────────────────────
# Voice Self-Care Agent — Environment Variables
# Copy this file to .env and fill in your values.
# Lines starting with # are comments / explanations.
# ─────────────────────────────────────────────────────────────────────────────


# ── OpenAI ────────────────────────────────────────────────────────────────────
# Required. Your OpenAI API key (must have Realtime API access).
OPENAI_API_KEY=sk-...

# Required. Your OpenAI Project ID — used to build the SIP URI:
#   sip:<OPENAI_PROJECT_ID>@sip.api.openai.com;transport=tls
# Find it at: https://platform.openai.com/settings/organization/projects
OPENAI_PROJECT_ID=proj_...

# Optional. OpenAI Realtime model name. Default: gpt-realtime
OPENAI_REALTIME_MODEL=gpt-realtime

# Optional. Model used to generate post-call summaries. Default: gpt-4o-mini
OPENAI_SUMMARY_MODEL=gpt-4o-mini

# Optional. Webhook signing secret for verifying OpenAI webhook signatures.
# Leave blank to skip signature verification (not recommended for production).
OPENAI_WEBHOOK_SECRET=

# Optional. Set to "true" to dump raw webhook bodies to stdout (debug only).
WEBHOOK_DUMP_BODY=false

# Optional. Set to "false" to omit tools from the SIP accept payload (A/B testing).
OPENAI_ACCEPT_TOOLS=true

# Optional. Set to "true" to use a short "You are a support agent." system prompt
# instead of the full medical instructions (useful for isolating audio issues).
OPENAI_ACCEPT_SIMPLE=false


# ── Telephony codec ───────────────────────────────────────────────────────────
# Hint for the G.711 codec to request from your telephony provider.
#   g711_ulaw  — PCMU, used in North America / most of the world (default)
#   g711_alaw  — PCMA, used in some European/African networks
# Note: this is a hint only. The SIP stack negotiates the final codec.
TELEPHONY_CODEC=g711_ulaw


# ── SignalWire ────────────────────────────────────────────────────────────────
# Required only if you are using SignalWire as your telephony provider.
SIGNALWIRE_PROJECT_ID=
SIGNALWIRE_TOKEN=
SIGNALWIRE_SPACE=your-space.signalwire.com

# Optional. Phone number to use for outbound SMS via SignalWire (E.164 format).
SIGNALWIRE_SMS_FROM=

# Optional. Override the SIP codec hint for SignalWire (e.g. PCMU or PCMA).
SIP_CODECS=


# ── Twilio ────────────────────────────────────────────────────────────────────
# Required only if you are using Twilio as your telephony provider.
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=

# Optional. WhatsApp-enabled Twilio number for post-call follow-up messages.
# Format: whatsapp:+14155238886  (the Twilio Sandbox number in development)
TWILIO_WHATSAPP_NUMBER=

# Optional. Regular SMS Twilio number for follow-up messages (fallback to WhatsApp).
TWILIO_SMS_NUMBER=

# Optional. Twilio Messaging Service SID (alternative to TWILIO_SMS_NUMBER).
TWILIO_MESSAGING_SERVICE_SID=

# Optional. Override the SIP codec hint for Twilio (e.g. PCMU or PCMA).
TWILIO_SIP_CODECS=


# ── Google Drive (optional) ───────────────────────────────────────────────────
# When configured, call transcripts and session notes are saved to Google Drive.
# Leave all three blank to disable Drive integration — the agent runs without it.

# Option A: base64-encoded JSON service account key
#   openssl base64 -in service-account.json | tr -d '\n'
GOOGLE_SERVICE_ACCOUNT=

# Option B: raw JSON content of the service account key (alternative to Option A)
GOOGLE_SERVICE_ACCOUNT_KEY=

# The ID of the Google Drive folder that acts as the root for patient records.
# The service account must have "Editor" access to this folder.
GOOGLE_DRIVE_FOLDER_ID=


# ── Server ────────────────────────────────────────────────────────────────────
# Public HTTPS URL of your deployed server. Used to build webhook callback URLs.
# Examples:
#   https://voicecare.fly.dev          (Fly.io)
#   https://abc123.ngrok-free.app      (ngrok for local dev)
PUBLIC_URL=https://your-deployment.example.com

PORT=8080
NODE_ENV=production
