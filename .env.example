# ─────────────────────────────────────────────────────────────────────────────
# Voice Self-Care Agent — Environment Variables
# Copy this file to .env and fill in your values.
# Lines starting with # are comments / explanations.
# ─────────────────────────────────────────────────────────────────────────────


# ── OpenAI ────────────────────────────────────────────────────────────────────
# Required. OpenAI API key from the same project that receives the SIP webhook.
# It needs GPT-Live plus Responses access.
OPENAI_API_KEY=sk-...

# Required. Your OpenAI Project ID — used to build the SIP URI:
#   sip:<OPENAI_PROJECT_ID>@sip.api.openai.com;transport=tls;secure=true
# Find it at: https://platform.openai.com/settings/organization/projects
OPENAI_PROJECT_ID=proj_...

# Voice transport. `live` is production; `realtime` is the rollback path.
OPENAI_VOICE_API=live

# GPT-Live voice and delegated reasoning models.
OPENAI_LIVE_MODEL=gpt-live-1
OPENAI_LIVE_BACKEND_MODEL=gpt-5.6-terra
OPENAI_LIVE_BACKEND_SERVICE_TIER=auto

# Realtime rollback model. Used only when OPENAI_VOICE_API=realtime.
OPENAI_REALTIME_MODEL=gpt-realtime-2

# Optional. OpenAI Realtime voice. Default: marin
OPENAI_REALTIME_VOICE=marin

# Optional. Model used to generate post-call summaries. Default: gpt-5.5
OPENAI_SUMMARY_MODEL=gpt-5.5

# Optional. Model used to consolidate phone-level memory after each call. Default: gpt-5.5
OPENAI_MEMORY_MODEL=gpt-5.5

# Optional. Model used for short provider/pharmacy option lookup. Default: gpt-5.4-mini
OPENAI_PROVIDER_MODEL=gpt-5.4-mini

# Realtime rollback only. GPT-Live supplies its own transcript events.
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-transcribe

# Optional. Keep spoken responses bounded without truncating audio. Default: 900
OPENAI_MAX_OUTPUT_TOKENS=900

# Realtime rollback only. Silence duration before Realtime responds. Default: 1200
VAD_SILENCE_MS=1200

# Optional. Finalize/export transcript after this much Realtime inactivity. Default: 120000
FINALIZE_IDLE_MS=120000

# Optional. After a Twilio completion callback, allow final GPT-Live transcript events to drain.
OPENAI_LIVE_FINALIZE_DRAIN_MS=1500

# Optional. Hard timeout for provider lookup during voice tool calls. Default: 2500
PROVIDER_LOOKUP_TIMEOUT_MS=2500

# The root /twilio/voice fallback remains health, but its route is disabled in the two-line setup.
SERVICE_MODE=health
HEALTH_LINE_ENABLED=false
JOZI_LINE_ENABLED=true
SELFCARE_LINE_ENABLED=true
HEALTH_PHONE_NUMBER=+12063098528
SELFCARE_PHONE_NUMBER=+12063098528
JOZI_PHONE_NUMBER=+14255173281

# Optional. Enables clearly labelled, presentation-only appointment/handoff simulations.
# No request is sent to a provider. Default: false
JOZI_DEMO_MODE=true

# Optional. Jozi/combined modes disable automatic outbound messages regardless.
AUTOMATIC_FOLLOWUP_ENABLED=false

# Optional. Store hashed phone-level memory for future calls. Default: true
CALLER_MEMORY_ENABLED=false

# Optional. Retain phone-level memory for this many days.
# Leave blank for consolidated memory that does not expire automatically.
CALLER_MEMORY_TTL_DAYS=

# Optional. Minimal Jozi call records omit phone/raw transcript and expire after this many days.
JOZI_TRANSCRIPT_TTL_DAYS=7

# Required for GPT-Live. Subscribe this endpoint to `live.transport.incoming`.
# The Worker refuses Live calls when this is missing or invalid.
OPENAI_WEBHOOK_SECRET=

# Optional. Set to "true" to dump raw webhook bodies to stdout (debug only).
WEBHOOK_DUMP_BODY=false

# Optional. Set to "false" to omit tools from the SIP accept payload (A/B testing).
OPENAI_ACCEPT_TOOLS=true

# Optional. Set to "true" to use a short "You are a support agent." system prompt
# instead of the full medical instructions (useful for isolating audio issues).
OPENAI_ACCEPT_SIMPLE=false


# ── Telephony codec ───────────────────────────────────────────────────────────
# Hint for the G.711 codec to request from your telephony provider.
#   g711_ulaw  — PCMU, used in North America / most of the world (default)
#   g711_alaw  — PCMA, used in some European/African networks
# Note: this is a hint only. The SIP stack negotiates the final codec.
TELEPHONY_CODEC=g711_ulaw


# ── SignalWire ────────────────────────────────────────────────────────────────
# Required only if you are using SignalWire as your telephony provider.
SIGNALWIRE_PROJECT_ID=
SIGNALWIRE_TOKEN=
SIGNALWIRE_SPACE=your-space.signalwire.com

# Optional. Phone number to use for outbound SMS via SignalWire (E.164 format).
SIGNALWIRE_SMS_FROM=

# Optional. Override the SIP codec hint for SignalWire (e.g. PCMU or PCMA).
SIP_CODECS=


# ── Twilio ────────────────────────────────────────────────────────────────────
# Required only if the Worker sends Twilio SMS or WhatsApp follow-up messages.
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=

# Optional. WhatsApp-enabled Twilio number for post-call follow-up messages.
# Format: whatsapp:+14155238886  (the Twilio Sandbox number in development)
TWILIO_WHATSAPP_NUMBER=

# Optional. Regular SMS Twilio number for follow-up messages (fallback to WhatsApp).
TWILIO_SMS_NUMBER=

# Optional. Twilio Messaging Service SID (alternative to TWILIO_SMS_NUMBER).
TWILIO_MESSAGING_SERVICE_SID=

# Optional. Override the SIP codec hint for Twilio (e.g. PCMU or PCMA).
TWILIO_SIP_CODECS=


# ── Admin / transcript access ─────────────────────────────────────────────────
# Optional. Enables /transcripts and GET /sessions/<call_id> when sent as:
#   Authorization: Bearer <ADMIN_TOKEN>
ADMIN_TOKEN=
